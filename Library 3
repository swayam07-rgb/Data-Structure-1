#include <iostream>
using namespace std;
int main()
{
    int book[5];
    cout<<"Enter 5 Book Ids:\n";
    for (int i = 0; i<5; i++)
        {
            cin>>book[i];
        }
    //sorting
    for (int i = 0; i < 4; i++)
        {
            for (int j = 0; j < 4 - i; j++)
                {
                    if (book[j] > book[j + i])
                    {
                        int temp = book[j];

                        book[j] = book[j + i];
                        book[j + i] = temp;
                    }
                }
        }
    cout<<"\nBooks after sorting:\n";
    for (int i = 0; i < 5; i++)
        {
            cout<< book[i] <<" ";
        }
    return 0;
}
